NODE_ENV=development
PORT=3000
APP_NAME=NearRide
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api/v1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nearride
DB_USER=nearride_user
DB_PASSWORD=change_this
DB_CONNECTION_LIMIT=10
JWT_ACCESS_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=
UPLOAD_DIRECTORY=public/uploads
MAX_IMAGES_PER_LISTING=2
MAX_IMAGE_SIZE_MB=5
AUTO_APPROVE_LISTINGS=false
DEFAULT_LISTING_EXPIRY_DAYS=60
DEFAULT_SEARCH_RADIUS_KM=25
CORS_ORIGINS=http://localhost:3000
REGISTRATION_ENCRYPTION_KEY=replace_with_32_byte_key_material
